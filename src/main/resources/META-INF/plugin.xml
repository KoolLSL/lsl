<idea-plugin>
    <id>io.github.koollsl.lsl</id>
    <name>LSL (Linden Scripting Language) Development Kit</name>
    <version>0.2.4</version>

    <vendor url="https://github.com/KoolLSL">KoolLSL</vendor>

    <description><![CDATA[
      Linden Script (LSL) language plugin.<br />
      See <a
            href="https://wiki.secondlife.com/wiki/LSL_Portal">official LSL documentation</a>.<br />
      Uses <a
            href="https://github.com/Sei-Lisa/kwdb">kwdb</a> database.<br />
      <br />
      Second Life (SL) and Second Life Eye-in-Hand Logo are registered trademarks of Linden Labs.<br />
      The plugin is third-party and does not support by Linden Labs.<br />
      <br />
      <b>WARNING:</b> the plugin is in early access and may contain problems.
      <br />
      Please report about issues to <a
            href="https://github.com/koollsl/lsl/issues">GitHub</a>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions
            defaultExtensionNs="com.intellij">
        <fileType
                name="LSL file"
                implementationClass="io.github.koollsl.lsl.LslFileType"
                fieldName="INSTANCE"
                language="LSL"
                extensions="lslp;lslm;lsl"/>
        <editorNotificationProvider
                implementation="io.github.koollsl.lsl.safeguards.LslBuildOutputNotificationProvider"/>
        <writingAccessProvider
                implementation="io.github.koollsl.lsl.safeguards.LslBuildOutputWritingAccessProvider"/>
        <lang.parserDefinition
                language="LSL"
                implementationClass="io.github.koollsl.lsl.parser.LslParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslSyntaxHighlighterFactory"/>
        <lang.commenter
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslCommenter"/>
        <lang.braceMatcher
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslPairedBraceMatcher"/>
        <lang.psiStructureViewFactory
                language="LSL"
                implementationClass="io.github.koollsl.lsl.structure.LslStructureViewFactory"/>
        <navbar
                implementation="io.github.koollsl.lsl.structure.LslStructureAwareNavBar"/>
        <lang.quoteHandler
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslQuoteHandler"/>
        <lang.documentationProvider
                language="LSL"
                implementationClass="io.github.koollsl.lsl.documentation.LslDocumentationProvider"/>
        <completion.contributor
                language="LSL"
                implementationClass="io.github.koollsl.lsl.completion.LslCompletionContributor"/>
        
        <langCodeStyleSettingsProvider
                implementation="io.github.koollsl.lsl.formatting.LslLanguageCodeStyleSettingsProvider" />

        <lang.foldingBuilder
                language="LSL"
                implementationClass="io.github.koollsl.lsl.structure.LslFoldingBuilder"/>
        <lang.findUsagesProvider
                language="LSL"
                implementationClass="io.github.koollsl.lsl.structure.LslFindUsagesProvider"/>
        <spellchecker.support
                language="LSL"
                implementationClass="io.github.koollsl.lsl.formatting.LslSpellcheckingStrategy"/>
        <lang.namesValidator
                language="LSL"
                implementationClass="io.github.koollsl.lsl.syntax.LslNamesValidator"/>

        <lang.formatter
                language="LSL"
                implementationClass="io.github.koollsl.lsl.formatting.LslFormattingModelBuilder"/>
        <psi.referenceContributor
                language="LSL"
                implementation="io.github.koollsl.lsl.references.LslReferenceContributor"/>

        <highlightErrorFilter
                implementation="io.github.koollsl.lsl.annotation.LslPreprocessorErrorFilter"/>
        <lang.inspectionSuppressor
                language="LSL"
                implementationClass="io.github.koollsl.lsl.annotation.LslDisabledCodeInspectionSuppressor"/>
        <annotator
                language="LSL"
                implementationClass="io.github.koollsl.lsl.annotation.LslDisabledCodeAnnotator"/>
        <annotator
                language="LSL"
                implementationClass="io.github.koollsl.lsl.annotation.LslAnnotator"/>
        <colorSettingsPage
                implementation="io.github.koollsl.lsl.syntax.LslColorSettingsPage"/>
        <iconProvider
                implementation="io.github.koollsl.lsl.LslIconProvider"/>

        <projectViewNodeDecorator
                implementation="io.github.koollsl.lsl.psi.LslProjectViewNodeDecorator"/>

        <postStartupActivity implementation="io.github.koollsl.lsl.psi.LslStartupActivity"/>

        <applicationConfigurable
                parentId="language"
                instance="io.github.koollsl.lsl.settings.LslSettingsConfigurable"
                id="io.github.koollsl.lsl.settings.LslSettingsConfigurable"
                displayName="LSL"/>

        <!-- inspections -->

        <internalFileTemplate
                name="Linden Script"/>
|
    </extensions>
    <actions>
        <action
                id="LSL.NewLindenScriptFile"
                class="io.github.koollsl.lsl.actions.LslCreateFileAction"
                text="Linden Script File"
                description="Create new Linden Script file">
            <add-to-group
                    group-id="NewGroup"
                    anchor="before"
                    relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>